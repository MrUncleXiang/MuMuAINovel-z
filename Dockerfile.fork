# 低资源机器专用二开镜像。
# 复用官方 MuMuAINovel 的 Python 依赖和离线向量模型，只叠加本 Fork 的代码。
# 这样部署机器已有的 2GB+ 基础层无需重新下载。
FROM node:22-alpine AS frontend-builder

WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN sed -i "s|outDir: '../backend/static'|outDir: 'dist'|g" vite.config.ts \
    && npm run build

# 锁定到本机当前稳定运行的 v1.4.9 镜像，确保部署时复用已有基础层，
# 也避免上游 latest 更新后悄悄改变运行环境。
FROM mumujie/mumuainovel@sha256:e212ef28ac02810f9c284f943a7e98500971ff0b954bcb4b1701d7c134076524

WORKDIR /app

# 后端业务代码（运行依赖沿用官方镜像）
COPY backend/app ./app

# 新增的数据库迁移和当前迁移配置。
# 官方 v1.4.9 的 alembic.ini 使用 alembic/postgres，不能覆盖成 alembic/versions。
COPY backend/alembic/postgres ./alembic/postgres
COPY backend/alembic-postgres.ini ./alembic.ini

# 前端构建产物
COPY --from=frontend-builder /frontend/dist ./static
